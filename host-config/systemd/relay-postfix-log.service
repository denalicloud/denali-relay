[Unit]
Description=Relay Postfix log forwarder
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/bin/bash -c 'docker compose -f /opt/relay/docker-compose.yml logs -f --no-log-prefix postfix >> /var/log/relay-postfix.log 2>&1'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
